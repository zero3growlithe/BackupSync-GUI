<Window x:Class="BackupSyncGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BackupSync"
        Height="650"
        Width="1000"
        MinHeight="520"
        MinWidth="860"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="13">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Header ───────────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="BackupSync" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock x:Name="HeaderSummaryTextBlock"
                               Margin="0,3,0,0"
                               FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Add configuration"
                            Click="AddConfiguration_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            Margin="0,0,8,0" />
                    <Button Content="Sync all" Click="SyncAll_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Content ──────────────────────────────────────────────────── -->
        <Grid Grid.Row="1" Margin="18,14,18,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="370" />
            </Grid.ColumnDefinitions>

            <!-- Configuration list -->
            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <ListBox x:Name="ConfigurationsListBox"
                             Style="{StaticResource ItemListBoxStyle}"
                             Padding="8"
                             SelectionChanged="ConfigurationsListBox_SelectionChanged"
                             MouseDoubleClick="ConfigurationsListBox_MouseDoubleClick"
                             PreviewKeyDown="ConfigurationsListBox_PreviewKeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Image Source="{Binding Icon}"
                                           Width="32"
                                           Height="32"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DestinationPath}"
                                                   Margin="0,2,0,0"
                                                   FontSize="11.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding DetailsText}"
                                                   Margin="0,2,0,0"
                                                   FontSize="11.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding StatusText}" Margin="0,3,0,0" FontSize="11.5">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsStatusWarning}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel x:Name="EmptyStatePanel"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="30">
                        <TextBlock Text="No backup configurations yet"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Use “Add configuration” to create one, or point it at a folder that already contains backup_setup.txt."
                                   Margin="0,8,0,0"
                                   MaxWidth="380"
                                   TextAlignment="Center"
                                   Style="{StaticResource HintTextStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Details -->
            <Border Grid.Column="2"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel x:Name="DetailsPanel" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Image x:Name="DetailIconImage" Width="40" Height="40" VerticalAlignment="Center" />
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="DetailNameTextBlock"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="DetailStatusTextBlock" Margin="0,3,0,0" FontSize="11.5" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="SOURCE" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock x:Name="DetailSourceTextBlock" FontSize="12" TextWrapping="Wrap" />
                            <Button x:Name="OpenSourceButton" Content="Open source folder" Click="OpenSource_Click" Margin="0,7,0,0" HorizontalAlignment="Left" Padding="11,5" />

                            <TextBlock Text="DESTINATION" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock x:Name="DetailDestinationTextBlock" FontSize="12" TextWrapping="Wrap" />
                            <Button x:Name="OpenDestinationButton" Content="Open destination folder" Click="OpenDestination_Click" Margin="0,7,0,0" HorizontalAlignment="Left" Padding="11,5" />

                            <TextBlock Text="APPLICATION" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock x:Name="DetailApplicationTextBlock" FontSize="12" TextWrapping="Wrap" />

                            <TextBlock Text="SELECTION RULES" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock x:Name="DetailRulesTextBlock" FontSize="12" TextWrapping="Wrap" />
                            <Button x:Name="EditFiltersButton" Content="Edit selection rules" Click="EditFilters_Click" Margin="0,7,0,0" HorizontalAlignment="Left" Padding="11,5" />

                            <TextBlock x:Name="DetailConfigurationTextBlock"
                                       Margin="0,14,0,0"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"
                                       Foreground="{StaticResource DangerBrush}" />

                            <Border Background="{StaticResource BorderBrush}" Height="1" Margin="0,16,0,14" />

                            <Button x:Name="SyncSelectedButton"
                                    Content="Sync now"
                                    Click="SyncSelected_Click"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch" />
                            <Button x:Name="LaunchSelectedButton"
                                    Content="Launch application"
                                    Click="LaunchSelected_Click"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Stretch" />
                            <Button x:Name="RemoveSelectedButton"
                                    Content="Remove from list…"
                                    Click="RemoveSelected_Click"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </ScrollViewer>

                    <TextBlock x:Name="DetailsEmptyTextBlock"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               MaxWidth="260"
                               TextAlignment="Center"
                               Style="{StaticResource HintTextStyle}"
                               Text="Select a backup configuration to see its folders and actions." />
                </Grid>
            </Border>
        </Grid>

        <!-- ── Footer ───────────────────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusFooterTextBlock"
                           VerticalAlignment="Center"
                           FontSize="11.5"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextMutedBrush}" />

                <Button Grid.Column="1"
                        Content="Scripts folder…"
                        Click="ScriptsFolder_Click"
                        Style="{StaticResource SubtleButtonStyle}"
                        Padding="10,4"
                        FontSize="11.5" />
            </Grid>
        </Border>
    </Grid>
</Window>
