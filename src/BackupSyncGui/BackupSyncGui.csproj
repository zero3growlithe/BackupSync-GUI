<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <AssemblyName>BackupSyncGui</AssemblyName>
    <RootNamespace>BackupSyncGui</RootNamespace>
    <Version>1.0.0</Version>
    <SourceRevisionId Condition="'$(SourceRevisionId)' == ''">local</SourceRevisionId>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InformationalVersion>$(Version)+$(SourceRevisionId)</InformationalVersion>
    <Company>zero3growlithe</Company>
    <Product>BackupSync GUI</Product>
    <Description>Desktop front-end for the BackupSync PowerShell utility.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- The PowerShell utility ships beside the executable so the app is self-contained. -->
  <ItemGroup>
    <None Include="..\..\PowerShell\**\*.*"
          Link="PowerShell\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
