<Window x:Class="BackupSyncGui.Views.RemoveConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remove configuration"
        Width="580"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="13">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleTextBlock"
                   Grid.Row="0"
                   Style="{StaticResource SectionTitleStyle}"
                   TextWrapping="Wrap" />

        <TextBlock Grid.Row="1"
                   Margin="0,8,0,0"
                   Style="{StaticResource HintTextStyle}"
                   Text="The configuration is removed from this list. Nothing inside the folders is touched unless you pick an option below." />

        <TextBlock x:Name="SourcePathTextBlock"
                   Grid.Row="2"
                   Margin="0,10,0,0"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextMutedBrush}" />

        <CheckBox x:Name="ShortcutFilesCheckBox"
                  Grid.Row="3"
                  Margin="0,16,0,0"
                  Content="Also delete this app's shortcut files from the source folder" />

        <TextBlock x:Name="ShortcutFilesTextBlock"
                   Grid.Row="4"
                   Margin="26,6,0,0"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextMutedBrush}" />

        <CheckBox x:Name="ConfigurationFileCheckBox"
                  Grid.Row="5"
                  Margin="0,14,0,0"
                  Content="Also delete the configuration file (backup_setup.txt)" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0" />
            <Button Content="Remove from list" Click="Remove_Click" Style="{StaticResource DangerButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
