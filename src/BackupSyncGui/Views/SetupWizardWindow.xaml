<Window x:Class="BackupSyncGui.Views.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BackupSyncGui.Views"
        Title="Add backup configuration"
        Width="780"
        Height="680"
        MinWidth="700"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="13">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Step header ─────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="StepTitleTextBlock" Style="{StaticResource SectionTitleStyle}" Text="Source folder" />
            <TextBlock x:Name="StepSubtitleTextBlock"
                       Margin="0,5,0,0"
                       Style="{StaticResource HintTextStyle}" />
            <TextBlock x:Name="StepCounterTextBlock"
                       Margin="0,6,0,0"
                       FontSize="11"
                       Foreground="{StaticResource TextMutedBrush}"
                       Text="Step 1 of 5" />
        </StackPanel>

        <!-- ── Steps ───────────────────────────────────────────────────── -->
        <Grid Grid.Row="1">

            <!-- Step 1: source -->
            <Grid x:Name="SourceStepPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Source folder" FontWeight="SemiBold" />
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SourcePathTextBox" />
                    <Button Grid.Column="1" Content="Browse…" Click="BrowseSource_Click" Margin="8,0,0,0" />
                </Grid>
                <TextBlock Grid.Row="2"
                           Margin="0,12,0,0"
                           Style="{StaticResource HintTextStyle}"
                           Text="This folder holds backup_setup.txt and the generated shortcuts. Its files are synchronized in both directions with the destination folder." />
                <TextBlock x:Name="SourceInfoTextBlock"
                           Grid.Row="3"
                           Margin="0,16,0,0"
                           Style="{StaticResource HintTextStyle}" />
            </Grid>

            <!-- Step 2: destination -->
            <Grid x:Name="DestinationStepPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Destination folder" FontWeight="SemiBold" />
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DestinationPathTextBox" LostFocus="DestinationPathTextBox_LostFocus" />
                    <Button Grid.Column="1" Content="Browse…" Click="BrowseDestination_Click" Margin="8,0,0,0" />
                </Grid>
                <TextBlock Grid.Row="2"
                           Margin="0,12,0,0"
                           Style="{StaticResource HintTextStyle}"
                           Text="Choose a dedicated folder that the sync may create and change. It cannot be the source folder, a folder inside it, or a drive root." />

                <CheckBox x:Name="InitializeCheckBox"
                          Grid.Row="3"
                          Margin="0,18,0,0"
                          Content="Initialize the source from the destination's backup_init.txt rules"
                          Visibility="Collapsed"
                          Checked="InitializeCheckBox_Changed"
                          Unchecked="InitializeCheckBox_Changed" />

                <StackPanel x:Name="ConflictPolicyPanel" Grid.Row="4" Margin="26,10,0,0" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource HintTextStyle}" Text="When a matching file has different content:" />
                    <ListBox x:Name="ConflictPolicyListBox"
                             Margin="0,6,0,0"
                             Height="112"
                             Style="{StaticResource CompactListBoxStyle}"
                             ItemContainerStyle="{StaticResource CompactListBoxItemStyle}">
                        <ListBoxItem Content="Use the destination copy (the current source file is kept in the recovery folder)" />
                        <ListBoxItem Content="Keep the source copy" />
                        <ListBoxItem Content="Abort the setup without touching any file" />
                    </ListBox>
                </StackPanel>

                <TextBlock x:Name="DestinationInfoTextBlock"
                           Grid.Row="5"
                           Margin="0,16,0,0"
                           Style="{StaticResource HintTextStyle}" />
            </Grid>

            <!-- Step 3: application -->
            <Grid x:Name="ExecutableStepPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Application to launch" FontWeight="SemiBold" />
                <TextBlock x:Name="ExecutableStatusTextBlock"
                           Grid.Row="1"
                           Margin="0,6,0,10"
                           Style="{StaticResource HintTextStyle}" />

                <Border Grid.Row="2"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7">
                    <ListBox x:Name="ExecutableListBox" Style="{StaticResource ItemListBoxStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Icon}" Width="20" Height="20" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Display}"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Button Grid.Row="3"
                        Content="Browse for another executable…"
                        Click="BrowseExecutable_Click"
                        HorizontalAlignment="Left"
                        Margin="0,12,0,0" />
            </Grid>

            <!-- Step 4: delay -->
            <Grid x:Name="DelayStepPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Delay before synchronizing" FontWeight="SemiBold" />
                <TextBox x:Name="DelayTextBox"
                         Grid.Row="1"
                         Width="130"
                         HorizontalAlignment="Left"
                         Margin="0,10,0,0"
                         Text="10" />
                <TextBlock Grid.Row="2"
                           Margin="0,12,0,0"
                           Style="{StaticResource HintTextStyle}"
                           Text="Seconds to wait after the application closes before the second sync starts. 0 starts immediately. The default is 10." />
            </Grid>

            <!-- Step 5: selection rules -->
            <Grid x:Name="FiltersStepPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Selection rules" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1"
                           Margin="0,6,0,10"
                           Style="{StaticResource HintTextStyle}"
                           Text="+rule includes, -rule excludes. Without a + rule every file is included. Rules with a slash are anchored at the folder root. These rules are written to backup_setup.txt and can be edited later." />
                <views:FilterEditorControl x:Name="RulesEditorControl" Grid.Row="2" />
                <CheckBox x:Name="OpenFolderCheckBox"
                          Grid.Row="3"
                          Margin="0,14,0,0"
                          Content="Open the source folder after saving"
                          IsChecked="True" />
            </Grid>
        </Grid>

        <!-- ── Footer ──────────────────────────────────────────────────── -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="MessageTextBlock"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource DangerBrush}" />

            <Button Grid.Column="1" Content="Cancel" Click="Cancel_Click" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="BackButton" Grid.Column="2" Content="Back" Click="Back_Click" IsEnabled="False" Margin="0,0,8,0" />
            <Button x:Name="NextButton" Grid.Column="3" Content="Next" Click="Next_Click" Style="{StaticResource AccentButtonStyle}" IsDefault="True" />
        </Grid>
    </Grid>
</Window>
